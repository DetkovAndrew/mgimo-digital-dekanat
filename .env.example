# Скопируйте в .env и заполните. .env не коммитится.

# PostgreSQL. Локально его поднимает `npm run db` (embedded-postgres).
DATABASE_URL="postgresql://dekanat:<пароль>@127.0.0.1:54329/dekanat"
# Отдельная пустая БД для prisma migrate dev. Не направлять на БД с нужными данными.
SHADOW_DATABASE_URL="postgresql://dekanat:<пароль>@127.0.0.1:54329/dekanat_shadow"
# Дополнительные БД, которые создаёт `npm run db`
PG_EXTRA_DATABASES="dekanat_shadow,dekanat_test"
# Каталог данных (по умолчанию ~/.local/share/digital-dekanat/postgres).
# Нужна ФС с правами Unix: на DrvFS (/mnt/c) PostgreSQL не запустится.
# PG_DATA_DIR=""

# Better Auth: случайная строка от 32 символов (openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://127.0.0.1:3000"

# Пароли тестовых аккаунтов для `npm run db:seed` (от 8 символов). Жюри получает их
# только в комментарии к работе — в репозиторий и в код они не попадают.
SEED_PASSWORD_STUDENT_A=""
SEED_PASSWORD_STUDENT_B=""
SEED_PASSWORD_STAFF=""

# Только для разработки на диске C: в WSL: опрос файлов для Fast Refresh (мс). На сервере не задавать.
# NEXT_WATCH_POLL_MS="1000"

# Отдельная БД для интеграционных тестов (npm run test:db). Не направлять на основную.
TEST_DATABASE_URL="postgresql://dekanat:<пароль>@127.0.0.1:54329/dekanat_test"

# GigaChat (ИИ-помощник «Спросить по кабинету»). Ключ авторизации из личного кабинета Sber Developers.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Необязательно: модель (по умолчанию GigaChat-2), адреса API и число одновременных запросов (тариф физлица — 1).
# GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_MAX_CONCURRENCY=1
