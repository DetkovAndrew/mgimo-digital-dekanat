# Скопируйте в .env на сервере (рядом с compose.yaml) и заполните. В git не коммитится.

# Домен без https:// — Caddy получит на него сертификат; DNS A-запись должна указывать на сервер.
DOMAIN=""

# Пароль PostgreSQL в контейнере: openssl rand -hex 24. Только буквы и цифры — compose вставляет его в адрес БД
# без кодирования, и символы вроде / или + адрес ломают.
POSTGRES_PASSWORD=""

# Better Auth: случайная строка от 32 символов (openssl rand -base64 32). BETTER_AUTH_URL задаёт compose из DOMAIN.
BETTER_AUTH_SECRET=""

# Пароли демо-аккаунтов для `npm run db:seed` (от 8 символов). Жюри получает их только в комментарии к работе.
SEED_PASSWORD_STUDENT_A=""
SEED_PASSWORD_STUDENT_B=""
SEED_PASSWORD_STAFF=""

# GigaChat (помощник Инвиктус). Ключ авторизации из личного кабинета Sber Developers.
GIGACHAT_AUTH_KEY=""
GIGACHAT_SCOPE=GIGACHAT_API_PERS
