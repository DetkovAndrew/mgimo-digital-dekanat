# HTTPS для домена: сертификат Let's Encrypt Caddy получает и продлевает сам (нужны открытые 80 и 443).
{
	# Токен справки в адресе /verify/… не пишется в журналы: при ошибке прокси Caddy логирует URI запроса
	# (ревью Codex 58; проверено на 502 — без фильтра токен в журнале, с фильтром нет).
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "^/verify/[^/?#]*" "/verify/REDACTED"
			}
		}
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# «?» — только если приложение не задало своё: страница проверки справки ставит no-referrer.
		?Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Концепт для конкурса, а не сервис вуза: в поиск не попадаем.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
