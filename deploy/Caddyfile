# HTTPS для домена: сертификат Let's Encrypt Caddy получает и продлевает сам (нужны открытые 80 и 443).
{
	# Токены в адресе — справки /verify/… и подписки на календарь /api/calendar/feed/… — не пишутся в журналы:
	# при ошибке прокси Caddy логирует URI запроса (ревью Codex 58; проверено на 502 — без фильтра токен в журнале).
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "^/(verify|api/calendar/feed)/[^/?#]*" "/$1/REDACTED"
			}
		}
	}
}

# Заголовки безопасности: и для ответов приложения, и для страницы «Уже чиним» (handle_errors их не наследует).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# «?» — только если приложение не задало своё: страница проверки справки ставит no-referrer.
		?Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Концепт для конкурса, а не сервис вуза: в поиск не попадаем.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

{$DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy app:3000

	# Приложение не отвечает (перезапуск после выкатки, падение): вместо пустой 502 страница «Уже чиним» с Инвиктией.
	# Страница собрана заранее (scripts/down-page.tsx), код ответа подставляет templates; сама она ждёт /api/health.
	handle_errors 502 503 504 {
		root * /srv/errors
		rewrite * /down.html
		templates
		import security_headers
		# Адрес может быть /verify/<токен>: опрос /api/health и значок не передают его в Referer (ревью Codex 88).
		header Referrer-Policy "no-referrer"
		header Cache-Control "no-store"
		header Retry-After "30"
		file_server
	}
}
