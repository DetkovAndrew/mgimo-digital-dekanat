// Схема БД «Цифрового деканата».
// Модели User/Session/Account/Verification/RateLimit генерирует Better Auth
// (`npx auth@1.7.18 generate --config src/server/auth.ts --output prisma/schema.prisma`);
// после перегенерации верните связи User -> student/staff/..., Session.pushSubscriptions, Account.@@unique([providerId, accountId])
// и раздел предметной модели ниже.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?
  displayUsername String?
  role            String    @default("student")
  sessions        Session[]
  accounts        Account[]

  student           StudentProfile?
  staff             StaffProfile?
  notifications     NotificationRecipient[]
  requestEvents     RequestEvent[]
  pushSubscriptions PushSubscription[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushSubscriptions PushSubscription[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId]) // добавлено вручную: идемпотентный seed
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ─── Предметная модель ───────────────────────────────────────────────────────
// Владелец личных данных — StudentProfile. Все запросы к личным данным фильтруются
// по studentId из серверной сессии (см. AGENTS.md, раздел «Безопасность»).

model StudentProfile {
  id               String     @id @default(cuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId          String
  group            StudyGroup @relation(fields: [groupId], references: [id])
  recordBookNumber String     @unique // вымышленный номер зачётной книжки
  studyForm        String     @default("очная")
  funding          String // «бюджет» | «договор»
  enrolledAt       DateTime   @db.Date
  /// Образ Инвиктии (src/lib/invictia/skins.ts); null — базовый. Открыт ли он, проверяет сервер при выборе и при показе.
  invictiaSkin     String?

  grades        GradeResult[]
  requests      Request[]
  sportBookings SportBooking[]
  sportExtra    SportExtraPoints[]
  roomBookings  RoomBooking[]
  avatar        StudentAvatar?
  printJobs     PrintJob[]
  wifi          WifiCredential?
  calendarFeed  CalendarFeed?

  @@index([groupId])
  @@map("student_profile")
}

/// Фото профиля: уже обрезанное и сжатое в браузере (docs/plans/avatars.md). Отдаётся только владельцу.
model StudentAvatar {
  studentId String         @id
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String // image/webp | image/jpeg | image/png
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  @@map("student_avatar")
}

/// Печать по коду (docs/plans/services.md): задание без файла — в демо печатается задание, а не документ.
/// Стоимость считает сервер; бюджет — месяц создания по МСК. Отмена и истечение срока возвращают страницы.
model PrintJob {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileName  String
  pages     Int
  copies    Int
  color     Boolean
  duplex    Boolean
  cost      Int
  code      String // 6 цифр: вводится у принтера
  status    PrintJobStatus @default(QUEUED)
  printerId String? // src/lib/campus/printers.ts
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  expiresAt DateTime       @db.Timestamptz(6)
  printedAt DateTime?      @db.Timestamptz(6)

  @@index([studentId, createdAt])
  @@map("print_job")
}

enum PrintJobStatus {
  QUEUED
  PRINTED
  CANCELLED
}

/// Версия личного пароля Wi-Fi. Сам пароль не хранится: HMAC от секрета сервера, студента и версии.
model WifiCredential {
  studentId String         @id
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  version   Int            @default(1)
  rotatedAt DateTime       @default(now()) @db.Timestamptz(6)

  @@map("wifi_credential")
}

/// Подписка на календарь (docs/plans/calendar.md): токен — HMAC от секрета сервера и версии, в БД только его SHA-256.
/// Новая ссылка — version + 1; старый токен перестаёт находиться.
model CalendarFeed {
  studentId String         @id
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  version   Int            @default(1)
  tokenHash String         @unique
  rotatedAt DateTime       @default(now()) @db.Timestamptz(6)

  @@map("calendar_feed")
}

/// Уведомления на телефон (docs/plans/push.md): подписка браузера привязана к сессии — выход удаляет сессию,
/// а с ней и подписку. endpoint — адрес службы push (только из списка в src/server/push/webpush.ts).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([sessionId])
  @@map("push_subscription")
}

model StaffProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    String
  // Граница доступа сотрудника деканата: видит заявки только студентов своего факультета.
  facultyCode String
  faculty     Faculty @relation(fields: [facultyCode], references: [code])

  lessonChanges LessonChange[]
  notifications Notification[]

  @@index([facultyCode])
  @@map("staff_profile")
}

model Faculty {
  code      String @id // короткий код, например «MO»
  title     String
  shortName String // «МО»

  groups StudyGroup[]
  staff  StaffProfile[]

  @@map("faculty")
}

model StudyGroup {
  id          String  @id @default(cuid())
  code        String  @unique
  facultyCode String
  faculty     Faculty @relation(fields: [facultyCode], references: [code])
  program     String // направление подготовки
  profile     String? // профиль / программа
  course      Int
  level       String  @default("бакалавриат")

  students  StudentProfile[]
  offerings CourseOffering[]

  @@index([facultyCode])
  @@map("study_group")
}

model AcademicTerm {
  id              String   @id @default(cuid())
  title           String // «Осенний семестр 2026/27»
  startsOn        DateTime @db.Date
  endsOn          DateTime @db.Date
  sessionStartsOn DateTime @db.Date
  sessionEndsOn   DateTime @db.Date

  offerings  CourseOffering[]
  sportExtra SportExtraPoints[]

  @@map("academic_term")
}

model Discipline {
  id         String  @id @default(cuid())
  title      String
  shortTitle String?

  offerings CourseOffering[]

  @@map("discipline")
}

// Учебный корпус. Координаты — для ссылок-маршрутов в Яндекс Картах и оценки времени в пути.
model Building {
  id      String  @id // короткий код, например «kronv»
  title   String // «Главный корпус»
  address String // «Кронверкский пр., 49»
  lat     Float
  lon     Float
  metro   String?

  lessons    Lesson[]
  sportSlots SportSlot[]
  rooms      Room[]

  @@map("building")
}

model Teacher {
  id       String  @id @default(cuid())
  fullName String // вымышленное ФИО
  position String?

  lessons   Lesson[]
  offerings CourseOffering[]

  @@map("teacher")
}

enum ControlForm {
  EXAM // экзамен
  CREDIT // зачёт
  GRADED_CREDIT // зачёт с оценкой
}

// Дисциплина конкретной группы в конкретном семестре.
model CourseOffering {
  id            String       @id @default(cuid())
  disciplineId  String
  discipline    Discipline   @relation(fields: [disciplineId], references: [id])
  groupId       String
  group         StudyGroup   @relation(fields: [groupId], references: [id])
  termId        String
  term          AcademicTerm @relation(fields: [termId], references: [id])
  leadTeacherId String
  leadTeacher   Teacher      @relation(fields: [leadTeacherId], references: [id])
  controlForm   ControlForm
  credits       Int // зачётные единицы

  lessons     Lesson[]
  assessments Assessment[]

  @@unique([disciplineId, groupId, termId])
  @@index([groupId, termId])
  @@map("course_offering")
}

enum LessonKind {
  LECTURE
  SEMINAR
  LANGUAGE
  PRACTICE
  CONSULTATION
}

enum LessonStatus {
  SCHEDULED
  RESCHEDULED // перенесено (время/аудитория изменены, история в LessonChange)
  CANCELLED
}

// Конкретное датированное занятие (без движка повторений — для прототипа достаточно).
model Lesson {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  kind       LessonKind
  startsAt   DateTime       @db.Timestamptz(6)
  endsAt     DateTime       @db.Timestamptz(6)
  buildingId String?
  building   Building?      @relation(fields: [buildingId], references: [id])
  room       String?
  roomId     String? // аудитория со схемы корпуса (src/lib/campus/plans.ts); заполняет scripts/sync-rooms.ts
  roomRef    Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  online     Boolean        @default(false)
  teacherId  String? // переопределение; по умолчанию — offering.leadTeacher
  teacher    Teacher?       @relation(fields: [teacherId], references: [id])
  status     LessonStatus   @default(SCHEDULED)

  changes       LessonChange[]
  notifications Notification[]

  @@index([offeringId, startsAt])
  @@index([startsAt])
  @@index([roomId, startsAt])
  @@map("lesson")
}

// Полный переход «было → стало». Занятие при переносе не пересоздаётся;
// изменение Lesson + LessonChange + уведомление выполняются одной транзакцией.
model LessonChange {
  id                 String        @id @default(cuid())
  lessonId           String
  lesson             Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  previousStatus     LessonStatus
  newStatus          LessonStatus
  previousStartsAt   DateTime      @db.Timestamptz(6)
  previousEndsAt     DateTime      @db.Timestamptz(6)
  previousRoom       String?
  previousBuildingId String?
  previousOnline     Boolean? // null — запись seed (до переноса сотрудником)
  newStartsAt        DateTime      @db.Timestamptz(6)
  newEndsAt          DateTime      @db.Timestamptz(6)
  newRoom            String?
  newBuildingId      String?
  reason             String?
  // Кто из деканата изменил пару; null — изменение из демо-данных. По первой записи сотрудника пару можно вернуть
  // как было (staff-schedule.ts) и откатить всё разом (`npm run db:undo-staff`).
  staffId            String?
  staff              StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)

  @@index([lessonId, createdAt])
  @@index([staffId])
  @@map("lesson_change")
}

enum AssessmentKind {
  EXAM
  CREDIT
  GRADED_CREDIT
  MIDTERM // рубежный контроль
  ASSIGNMENT // работа с дедлайном (эссе, доклад, курсовая)
}

model Assessment {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  kind        AssessmentKind
  title       String
  scheduledAt DateTime?      @db.Timestamptz(6) // для экзаменов/зачётов
  dueAt       DateTime?      @db.Timestamptz(6) // для работ с дедлайном
  room        String?
  // Максимум баллов за элемент. Сумма по дисциплине за семестр — 100 (проверяет seed/сервис).
  maxPoints   Int?

  results GradeResult[]

  @@index([offeringId])
  @@map("assessment")
}

model GradeResult {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  // CHECK в миграции: attempt > 0; grade 2–5; points >= 0; есть хотя бы одно из grade/passed/points.
  // Нет результата — нет строки. Группа студента = группа испытания — проверяет сервис.
  attempt      Int            @default(1)
  grade        Int? // 2–5 для экзамена / зачёта с оценкой / работ
  passed       Boolean? // для зачёта
  points       Float? // баллы за элемент контроля (БаРС)
  comment      String?
  gradedAt     DateTime       @db.Timestamptz(6)

  @@unique([studentId, assessmentId, attempt])
  @@index([assessmentId])
  @@map("grade_result")
}

enum RequestStatus {
  SUBMITTED // подана
  IN_PROGRESS // в работе
  NEEDS_INFO // нужно уточнение от студента
  READY // готова (справку можно забрать / скачать)
  DONE // выдана / исполнена
  REJECTED // отклонена
  CANCELLED // отозвана студентом
}

model Request {
  id        String         @id @default(cuid())
  number    Int            @unique @default(autoincrement()) // показывается как «З-000123»
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String // ключ из каталога заявок в коде (src/server/requests/catalog.ts)
  status    RequestStatus  @default(SUBMITTED)
  payload   Json // поля заявления, провалидированные схемой типа
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  events        RequestEvent[]
  notifications Notification[]
  document      IssuedDocument?

  @@index([studentId, createdAt])
  @@index([status])
  @@map("request")
}

/// Электронная справка (docs/plans/certificates.md): выпускается при переводе заявки в «Готово», одна на заявку.
/// Владелец — через заявку. content — снимок данных на дату выдачи (схема в src/lib/documents/certificate.ts).
model IssuedDocument {
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement()) // показывается как «С-000012»
  requestId   String   @unique
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind        String // study_certificate
  verifyToken String   @unique // 16 случайных байт base64url: ссылка проверки из QR, секрет как пароль
  content     Json
  issuedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@map("issued_document")
}

enum ActorType {
  STUDENT
  STAFF
  SYSTEM
}

model RequestEvent {
  id          String         @id @default(cuid())
  requestId   String
  request     Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  actorType   ActorType
  actorUserId String?
  actor       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  comment     String? // видно студенту
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)

  @@index([requestId, createdAt])
  @@map("request_event")
}

enum NotificationKind {
  ANNOUNCEMENT // объявление деканата
  SCHEDULE_CHANGE // перенос / отмена
  DEADLINE // напоминание о сроке
  REQUEST_STATUS // изменился статус заявки
}

model Notification {
  id          String           @id @default(cuid())
  kind        NotificationKind
  title       String
  body        String
  important   Boolean          @default(false)
  publishedAt DateTime         @default(now()) @db.Timestamptz(6)
  lessonId    String?
  lesson      Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  requestId   String?
  request     Request?         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Автор из деканата: объявление или перенос пары. Объявление можно отозвать; null — демо-данные и системные.
  staffId     String?
  staff       StaffProfile?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  recipients NotificationRecipient[]

  @@index([publishedAt])
  @@index([staffId])
  @@index([lessonId])
  @@index([requestId])
  @@map("notification")
}

// Адресная доставка: объявление группе/факультету разворачивается в получателей при создании.
model NotificationRecipient {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?    @db.Timestamptz(6)
  // Студент убрал уведомление у себя (смахнул или выбрал и удалил). Само уведомление общее — скрывается только доставка;
  // метка момента — «Вернуть» отменяет именно эту операцию. Демо-аккаунты: `npm run db:restore-notifications`.
  hiddenAt       DateTime?    @db.Timestamptz(6)

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, hiddenAt])
  @@map("notification_recipient")
}

// ─── Физкультура: честная запись (правило University, демо) ──────────────────
// Все изменения одной недели (приоритеты, жеребьёвка, отмена, продвижение очереди)
// выполняются в транзакции с блокировкой строки SportWeek (SELECT … FOR UPDATE).

// Неделя физкультуры: строка нужна для блокировки (SELECT … FOR UPDATE) —
// запись, отмена и продвижение очереди внутри недели выполняются по одной.
model SportWeek {
  weekStart DateTime @id @db.Date // понедельник (московская дата)

  slots    SportSlot[]
  bookings SportBooking[]

  @@map("sport_week")
}

model SportSection {
  id          String  @id @default(cuid())
  title       String // «Волейбол»
  description String?

  slots SportSlot[]

  @@map("sport_section")
}

model SportSlot {
  id         String       @id @default(cuid())
  sectionId  String
  section    SportSection @relation(fields: [sectionId], references: [id])
  weekStart  DateTime     @db.Date
  week       SportWeek    @relation(fields: [weekStart], references: [weekStart])
  startsAt   DateTime     @db.Timestamptz(6)
  endsAt     DateTime     @db.Timestamptz(6)
  buildingId String
  building   Building     @relation(fields: [buildingId], references: [id])
  room       String
  coach      String // вымышленное ФИО тренера
  capacity   Int

  bookings SportBooking[]

  @@index([weekStart, startsAt])
  @@map("sport_slot")
}

enum SportBookingStatus {
  CONFIRMED // записан, место есть
  WAITLIST // в очереди, место не подтверждено
  CANCELLED // отменено студентом до начала (место и квота вернулись)
  ATTENDED // посетил (+5 баллов)
  MISSED // не пришёл без отмены (квота потрачена)
}

model SportBooking {
  id        String             @id @default(cuid())
  studentId String
  student   StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slotId    String
  slot      SportSlot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  weekStart DateTime           @db.Date
  week      SportWeek          @relation(fields: [weekStart], references: [weekStart])
  status    SportBookingStatus
  statusAt  DateTime           @default(now()) @db.Timestamptz(6) // смена статуса; порядок очереди — FIFO по нему
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([studentId, slotId])
  @@index([slotId, status])
  @@index([studentId, weekStart])
  @@map("sport_booking")
}

// Дополнительные баллы (соревнования, нормативы). Начисляет только вуз, не студент.
model SportExtraPoints {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      AcademicTerm   @relation(fields: [termId], references: [id])
  title     String
  points    Int
  awardedAt DateTime       @db.Timestamptz(6)

  @@index([studentId, termId])
  @@map("sport_extra_points")
}

// ─── Аудитории и бронирование (docs/plans/rooms.md) ──────────────────────────
// Раскладка схем — в коде (src/lib/campus/plans.ts); здесь — аудитории и брони.

enum RoomKind {
  LECTURE_HALL
  CLASSROOM
  COMPUTER_LAB
  LAB
  COWORKING
  MEETING
}

model Room {
  id         String   @id // «kronv-2337»
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  number     String // «2337»: крыло, этаж, номер
  wing       Int
  floor      Int
  kind       RoomKind
  capacity   Int
  bookable   Boolean  @default(false)
  title      String? // «Коворкинг „Атриум“»

  lessons  Lesson[]
  bookings RoomBooking[]

  @@unique([buildingId, number])
  @@map("room")
}

enum RoomBookingStatus {
  CONFIRMED
  CANCELLED
}

model RoomBooking {
  id          String            @id @default(cuid())
  roomId      String
  room        Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startsAt    DateTime          @db.Timestamptz(6)
  endsAt      DateTime          @db.Timestamptz(6)
  purpose     String
  status      RoomBookingStatus @default(CONFIRMED)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  cancelledAt DateTime?         @db.Timestamptz(6)

  @@index([roomId, startsAt])
  @@index([studentId, startsAt])
  @@map("room_booking")
}
